{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with reading streaks, daily goals, and RBAC metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "User email address" },
        "name": { "type": "string", "description": "User full name" },
        "role": {
          "type": "string",
          "enum": ["super_admin", "manager", "user", "main_admin", "sub_admin", "admin", "tutor", "member"],
          "description": "The authoritative user access level"
        },
        "assigned_sections": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sections assigned to managers: school_1, school_2, bookstore, mission"
        },
        "avatarUrl": { "type": "string", "description": "Optional image avatar reference URL" },
        "readingStreak": { "type": "integer", "description": "Continuous streak of active reading" },
        "dailyGoalMinutes": { "type": "integer", "description": "User personal reading minutes objective target" },
        "isSuspended": { "type": "boolean", "description": "True if suspended by administration" },
        "authorizedCourses": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Courses a tutor is authorized to examine"
        }
      },
      "required": ["email", "name", "role"]
    },
    "SubAdminPermission": {
      "title": "SubAdminPermission",
      "description": "Granular capability permissions assigned to sub-administrators exclusively by main administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "allowBroadcast": { "type": "boolean" },
        "allowApproval": { "type": "boolean" },
        "allowVault": { "type": "boolean" },
        "allowManageBooks": { "type": "boolean" },
        "allowConfirmPayments": { "type": "boolean" },
        "allowManageEnrollments": { "type": "boolean" },
        "allowManageExams": { "type": "boolean" },
        "allowIssueCertificates": { "type": "boolean" },
        "allowModeration": { "type": "boolean" },
        "allowSuspendUsers": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "updatedAt"]
    },
    "Book": {
      "title": "Book",
      "description": "Digital books stored in active catalog library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "coverImage": { "type": "string" },
        "fileSize": { "type": "string" },
        "pages": { "type": "integer" },
        "publishedDate": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "draft"] },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "integer" }
      },
      "required": ["id", "title", "author", "price", "category", "description", "coverImage", "fileSize", "pages", "publishedDate", "isFeatured", "status", "rating", "reviewsCount"]
    },
    "Review": {
      "title": "Review",
      "description": "E-Book critique comments and scores from users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "text": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "text", "date"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Threaded discussions on digital book resources",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "date": { "type": "string" },
        "parentId": { "type": "string" }
      },
      "required": ["id", "targetId", "userId", "userName", "text", "date"]
    },
    "SocialPost": {
      "title": "SocialPost",
      "description": "Community social posts editable only by owner or moderator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "targetId", "userId", "userName", "text", "date"]
    },
    "CommunityMessage": {
      "title": "CommunityMessage",
      "description": "Discussions and group lessons in Bungoma Community",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channel": { "type": "string", "enum": ["#General", "#Book Talks", "#Leadership", "#Publishing", "#workers", "#faculty", "#generatechat"] },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "text": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "parentId": { "type": "string" }
      },
      "required": ["id", "channel", "userId", "userName", "text", "date", "time"]
    },
    "GroupMembership": {
      "title": "GroupMembership",
      "description": "Restricted group channel access list",
      "type": "object",
      "properties": {
        "channel": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "addedBy": { "type": "string" }
      },
      "required": ["channel", "userId"]
    },
    "SavedDocument": {
      "title": "SavedDocument",
      "description": "Personal document extracts generated on Document Studio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["pdf", "doc", "video", "photo"] },
        "folder": { "type": "string" },
        "date": { "type": "string" },
        "fileSize": { "type": "string" },
        "downloadUrl": { "type": "string" }
      },
      "required": ["id", "userId", "title", "content", "type", "folder", "date", "fileSize"]
    },
    "MemberUploadRequest": {
      "title": "MemberUploadRequest",
      "description": "Files uploaded by users requiring approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["pdf", "video", "photo", "audio"] },
        "fileSize": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "pending_delete"] },
        "allowedToPublic": { "type": "boolean" },
        "date": { "type": "string" },
        "contentUrl": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "title", "type", "fileSize", "status", "allowedToPublic", "date"]
    },
    "Annotation": {
      "title": "Annotation",
      "description": "User highlights and notes for digital books",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bookId": { "type": "string" },
        "page": { "type": "integer" },
        "text": { "type": "string" },
        "comment": { "type": "string" },
        "color": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "bookId", "page", "text", "date"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application environment preferences",
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string" },
        "fontSizeMultiplier": { "type": "number" },
        "customLogoUrl": { "type": "string" }
      },
      "required": ["primaryColor", "fontSizeMultiplier"]
    },
    "BookOrder": {
      "title": "BookOrder",
      "description": "Purchased eBook order requiring trusted payment confirmation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "bookId": { "type": "string" },
        "bookTitle": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "bookId", "bookTitle", "price", "status", "date"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "School course enrollment request & administrative approval record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTopic": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "feeStatus": { "type": "string", "enum": ["unpaid", "paid"] },
        "certificateIssued": { "type": "boolean" },
        "enrolledAt": { "type": "string" }
      },
      "required": ["id", "userId", "studentName", "courseId", "status", "feeStatus", "certificateIssued"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Published exam questions strictly separated from confidential answer keys",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseTrack": { "type": "string" },
        "title": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "maxAttempts": { "type": "integer" },
        "resultsReleased": { "type": "boolean" }
      },
      "required": ["id", "courseTrack", "title", "resultsReleased"]
    },
    "ExamAnswerKey": {
      "title": "ExamAnswerKey",
      "description": "Confidential answer keys accessible only to authorized examiners",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "courseTrack": { "type": "string" },
        "answers": { "type": "array" },
        "updatedBy": { "type": "string" }
      },
      "required": ["examId", "courseTrack", "answers"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Student exam attempt with server-computed score protection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "courseTrack": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["in_progress", "submitted", "expired"] },
        "score": { "type": "number" },
        "passed": { "type": "boolean" }
      },
      "required": ["id", "examId", "courseTrack", "userId", "status"]
    },
    "FeePayment": {
      "title": "FeePayment",
      "description": "Student tuition, certificate, and fee payment confirmations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "feeType": { "type": "string", "enum": ["library", "certificate", "tuition", "wifi"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "rejected"] },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "feeType", "amount", "status", "date"]
    },
    "CertificateDownload": {
      "title": "CertificateDownload",
      "description": "Verified issued school certificates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "courseTopic": { "type": "string" },
        "score": { "type": "number" },
        "ledgerHash": { "type": "string" }
      },
      "required": ["id", "email", "courseTopic", "score", "ledgerHash"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "Alert notifications broadcasted by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["free_book", "wifi_alert", "general"] },
        "targetBookId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "message", "type", "date"]
    },
    "WifiPurchase": {
      "title": "WifiPurchase",
      "description": "WiFi hotspots packages purchased by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "planName": { "type": "string" },
        "price": { "type": "number" },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "expiresAt": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "planName", "price", "phoneNumber", "status", "expiresAt", "date"]
    },
    "SearchHistory": {
      "title": "SearchHistory",
      "description": "Private per-user AI search history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "query": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "query", "date"]
    },
    "SermonVideo": {
      "title": "SermonVideo",
      "description": "Admin uploaded sermons and motivational videos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "speaker": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["Sermon", "Motivation", "Evangelism", "Worship Songs"] },
        "duration": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "speaker", "videoUrl", "thumbnailUrl", "category", "date"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only immutable audit log for privileged actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "actorId": { "type": "string" },
        "actorEmail": { "type": "string" },
        "category": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "timestamp", "actorId", "category", "action"]
    },
    "UserHistory": {
      "title": "UserHistory",
      "description": "Personal AI generation and study history synced per authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 80 },
        "prompt": { "type": "string", "maxLength": 8000 },
        "response": { "type": "string", "maxLength": 40000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "category", "createdAt"]
    },
    "UserFile": {
      "title": "UserFile",
      "description": "Metadata index for private user-uploaded study documents and images",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "path": { "type": "string", "maxLength": 512 },
        "name": { "type": "string", "maxLength": 256 },
        "size": { "type": "integer" },
        "mimeType": { "type": "string", "maxLength": 128 },
        "folder": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "path", "name", "size", "mimeType"]
    },
    "UserActivity": {
      "title": "UserActivity",
      "description": "User login and reading activity logs for administrative monitoring",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 128 },
        "actionType": { "type": "string", "maxLength": 80 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string" },
        "formattedDate": { "type": "string" }
      },
      "required": ["id", "userEmail", "actionType", "timestamp"]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "Per-user bookmark and percentage progress across digital books",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookId": { "type": "string", "maxLength": 128 },
        "currentPage": { "type": "integer" },
        "percentage": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "bookId", "currentPage", "percentage", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Campus and ministry notices published by authorized staff",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "text": { "type": "string", "maxLength": 4000 },
        "category": { "type": "string", "enum": ["general", "academic", "financial", "technical", "important"] },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "author": { "type": "string", "maxLength": 128 },
        "isSticky": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["title", "text", "category", "author", "timestamp"]
    },
    "CampusPhoto": {
      "title": "CampusPhoto",
      "description": "Official Bungoma campus and ministry showcase photos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "libraryCategory": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "title", "libraryCategory", "url"]
    }
  },
  "firestore": {
    "/appSettings/{settingsId}": { "schema": "AppSettings", "description": "Global settings database" },
    "/users/{userId}": { "schema": "User", "description": "User profiles database" },
    "/subAdminPermissions/{permId}": { "schema": "SubAdminPermission", "description": "Sub-admin permissions controlled by main admin" },
    "/books/{bookId}": { "schema": "Book", "description": "Digital eBooks database" },
    "/reviews/{reviewId}": { "schema": "Review", "description": "Dynamic eBook critical reviews" },
    "/comments/{commentId}": { "schema": "Comment", "description": "Contextual eBook comments tree" },
    "/socialPosts/{postId}": { "schema": "SocialPost", "description": "Community social posts" },
    "/communityMessages/{messageId}": { "schema": "CommunityMessage", "description": "Universal discussion channels" },
    "/groupMemberships/{membershipId}": { "schema": "GroupMembership", "description": "Restricted group memberships" },
    "/savedDocuments/{docId}": { "schema": "SavedDocument", "description": "Document Studio vault" },
    "/uploadRequests/{requestId}": { "schema": "MemberUploadRequest", "description": "Member upload moderation queue" },
    "/annotations/{annotationId}": { "schema": "Annotation", "description": "User highlights and annotations" },
    "/bookOrders/{orderId}": { "schema": "BookOrder", "description": "Purchased eBook orders" },
    "/enrollments/{enrollmentId}": { "schema": "Enrollment", "description": "School course enrollments" },
    "/exams/{examId}": { "schema": "Exam", "description": "Sanitized published exams" },
    "/examAnswerKeys/{examId}": { "schema": "ExamAnswerKey", "description": "Confidential examiner-only answer keys" },
    "/examAttempts/{attemptId}": { "schema": "ExamAttempt", "description": "Student exam attempts" },
    "/feePayments/{paymentId}": { "schema": "FeePayment", "description": "Fee payments" },
    "/certificate_downloads/{certId}": { "schema": "CertificateDownload", "description": "Issued certificates" },
    "/notifications/{notificationId}": { "schema": "SystemNotification", "description": "Broadcasted notifications" },
    "/wifiPurchases/{purchaseId}": { "schema": "WifiPurchase", "description": "WiFi hotspot purchases" },
    "/searchHistories/{historyId}": { "schema": "SearchHistory", "description": "Private AI search histories" },
    "/sermonVideos/{videoId}": { "schema": "SermonVideo", "description": "Sermon and motivational videos" },
    "/auditLogs/{logId}": { "schema": "AuditLog", "description": "Immutable security audit log" },
    "/userHistory/{historyId}": { "schema": "UserHistory", "description": "Private per-user AI generation and study history" },
    "/userFiles/{fileId}": { "schema": "UserFile", "description": "Private per-user file storage metadata index" },
    "/user_activities/{logId}": { "schema": "UserActivity", "description": "Authenticated user activity audit entries" },
    "/reading_progress/{progressId}": { "schema": "ReadingProgress", "description": "Per-user book reading progress" },
    "/announcements/{announcementId}": { "schema": "Announcement", "description": "Official campus announcements" },
    "/campusPhotos/{photoId}": { "schema": "CampusPhoto", "description": "Official campus gallery photos" }
  }
}
