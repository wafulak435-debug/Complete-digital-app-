# ============================================================
# FRONTEND (PUBLIC) ENVIRONMENT VARIABLES (Vite / Cloudflare Pages)
# Safe to expose in browser bundles — NEVER put secret keys here.
# Supports both VITE_* and NEXT_PUBLIC_* client prefixes.
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================================
# SERVER / SUPABASE EDGE FUNCTION SECRETS (Private Only)
# Set these in Google AI Studio Secrets & Supabase Edge Function Secrets.
# NEVER prefix secret keys with VITE_ or NEXT_PUBLIC_, or commit literal keys.
# ============================================================
GEMINI_API_KEY=
PAYSTACK_SECRET_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
APP_URL=
ADMIN_ACCESS_PASSCODE=

# ============================================================
# SAFARICOM M-PESA DARAJA CONFIGURATION (Private Server Secrets)
# Configure in Google Cloud Secret Manager / Cloud Run Environment Variables.
# Separate Sandbox and Production configurations.
# ============================================================
# MPESA_ENV: "sandbox" (default for testing) or "production" (live payments)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Shortcode: 1171473 (from your approved Daraja production app)
MPESA_SHORTCODE=
# Shortcode type: "paybill" (CustomerPayBillOnline) or "till" (CustomerBuyGoodsOnline)
MPESA_SHORTCODE_TYPE=paybill
# Optional: Store number if your Buy Goods Till is linked to a parent store
MPESA_STORE_NUMBER=
# Secure HTTPS Webhook Callback URL:
MPESA_CALLBACK_URL=https://complete-digital-app-486825715709.europe-west3.run.app/api/mpesa/callback

